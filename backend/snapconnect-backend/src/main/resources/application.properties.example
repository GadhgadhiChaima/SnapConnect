spring.application.name=snapconnect-backend

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/snapconnect?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_db_password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

server.port=8080

# JWT Configuration (Min 32 bytes / Base64)
jwt.secret=c25hcGNvbm5lY3Qtc3VwZXItc2VjcmV0LWp3dC1rZXktbWluaW11bS0zMi1ieXRlcy0yMDI2
jwt.expiration=86400000

# Google OAuth Client ID
# Remplacez par votre Google Cloud Console OAuth 2.0 Client ID
google.client.id=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

spring.jpa.open-in-view=false

# Default Admin credentials
admin.default.email=admin@snapconnect.com
admin.default.password=ChangeMe123!
admin.default.fullname=Admin SnapConnect

# Multipart file upload limits (supports HD smartphone photos and 4K vertical videos)
spring.servlet.multipart.max-file-size=200MB
spring.servlet.multipart.max-request-size=200MB
logging.file.name=logs/spring.log
